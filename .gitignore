# Dependencies
node_modules/

# Build output
dist/
*.cjs.map

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example

# Defense-in-depth: generic secret/key filenames (exact basename or path).
# These match only files named exactly so — they do NOT match legitimate
# source like src/server/credentialCrypto.ts (basename != "credentials").
*.pem
*.key
secrets
credentials
api_keys.txt
encryption.key
config/secrets.json

# Local databases / runtime data
*.db
*.db-journal
*.sqlite
*.sqlite-journal
data/

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
ai-agent-builder.zip
