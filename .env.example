# ---------------------------------------------------------------------------
# AI Agent Factory — environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the values you need. Only two variables are
# REQUIRED to run the platform core; everything else is optional and only
# needed when you enable that specific integration.
# ---------------------------------------------------------------------------

# === REQUIRED (core platform) ==============================================

# Secret used to sign session cookies. MUST be a long random string in
# production. In development, a dev secret is auto-generated if this is unset,
# but production REFUSES to start without it.
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite database file path. Defaults to ./data/agentfactory.db if unset.
# (Phase 2 persists everything to SQLite; PostgreSQL+pgvector is the
# documented production upgrade path.)
DB_PATH=./data/agentfactory.db

# Public origin of THIS platform, used to build the absolute widget embed URL
# shown to customers in the delivery onboarding artifact (the widget is
# embedded on the CUSTOMER's website, so a relative URL would not work).
# Must be a strict origin: https://your-platform-domain.com (no path, no
# trailing slash needed). In development it falls back to
# http://localhost:$PORT, so this is OPTIONAL locally.
PLATFORM_PUBLIC_URL=

# Master key for encrypting integration credentials at rest (AES-256-GCM).
# Integration credentials (Google/Meta/Twilio tokens) are encrypted with this
# key before being written to the database and decrypted only inside trusted
# server-side integration code. The key is NEVER stored in the database.
# If unset, the key is derived from SESSION_SECRET. If NEITHER is available,
# credential storage refuses to run (never stores plaintext). Set a dedicated
# value to rotate credential encryption independently of session signing.
INTEGRATION_ENCRYPTION_KEY=

# === OPTIONAL: AI provider =================================================
# The platform is FREE-FIRST: it runs without a paid AI API. Each agent
# declares an `llmProvider` (`gemini` | `ollama`). When no provider is
# declared, the runtime picks `gemini` if a key is present, otherwise the
# local/free `ollama` provider — so a fresh install works with no paid key.

# Google Gemini API key for the agent runtime (chat) and embeddings (RAG).
# If absent: agents without an explicit provider fall back to Ollama; RAG
# falls back to keyword retrieval. The platform still starts and all other
# features work.
GEMINI_API_KEY=

# --- Lead discovery (optional external provider) ---
# Google Places API (New) Text Search key. OPTIONAL. When absent the
# google_places provider reports NOT_CONFIGURED, no request is ever made,
# and manual_list discovery continues to work. Non-ID Places content is
# retention-bound (30 days) — see discoveryProvidersGoogle.ts.
GOOGLE_PLACES_API_KEY=
# Optional knobs (safe defaults shown; invalid values fall back):
# DISCOVERY_PROVIDER_TIMEOUT_MS=15000
# DISCOVERY_MAX_RESULTS=20

# Ollama (local / open-source models) — no API key, no paid vendor.
# Install Ollama (https://ollama.com) and pull a model, e.g. `ollama pull llama3.1`.
# The daemon serves an OpenAI-compatible /api/chat endpoint with tool calling.
# When the daemon is down, the runtime degrades gracefully (honest "trouble
# connecting" reply + WAITING_FOR_HUMAN) and never fabricates an answer.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# LLM request timeout (milliseconds). Bounds every outbound LLM/embedding
# network call so a hung/slow provider daemon cannot hold a request open
# indefinitely. On timeout the adapter returns its normalized error response
# and the runtime degrades to the graceful human-handoff reply — it never
# fabricates an answer and never throws an uncaught error. Invalid/negative/
# zero values always fall back to the default (protection cannot be disabled).
LLM_REQUEST_TIMEOUT_MS=60000
# Optional per-provider overrides (honored over the global value):
# OLLAMA_REQUEST_TIMEOUT_MS=
# GEMINI_REQUEST_TIMEOUT_MS=

# --- RAG embeddings (free-first) ---
# The embedding pipeline resolves the same way as chat: gemini when a key is
# present, else the local Ollama embedding model. Pull it once:
#   `ollama pull nomic-embed-text`
# Force a specific embedding provider regardless of the chat provider:
# EMBEDDING_PROVIDER=gemini|ollama
EMBEDDING_PROVIDER=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# === OPTIONAL: server ======================================================

# Port the server listens on (default 3000).
PORT=3000

# Set to "production" to serve the built frontend from dist/ and require a
# real SESSION_SECRET.
NODE_ENV=development

# === OPTIONAL: Google Calendar integration (Phase 13) =====================
# Configure to let appointments sync to a business's Google Calendar.
# If absent: integration status = NOT_CONFIGURED; internal appointments still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# === OPTIONAL: Meta / Instagram integration (Phase 14) ====================
# Official Meta Business messaging. If absent: NOT_CONFIGURED.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# === OPTIONAL: Twilio telephony / missed-call AI receptionist (Phase 15) ===
# If absent: NOT_CONFIGURED.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === OPTIONAL: Voice AI provider (Phase 16) ===============================
# If absent: voice disabled; text chat unaffected.
VOICE_AI_API_KEY=
VOICE_AI_ENDPOINT=
